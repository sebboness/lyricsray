{
  "name": "lyricsray-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --project tsconfig.json dev-server.ts",
    "build": "esbuild index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@aws-sdk/*",
    "build:rollup": "esbuild indexRollup.ts --bundle --platform=node --target=node20 --outfile=dist/indexRollup.js --external:@aws-sdk/*",
    "build:zip": "npm run build && cd dist && zip -j ../lambda.zip index.js",
    "build:zip:rollup": "npm run build:rollup && cd dist && zip -j ../lambda-rollup.zip indexRollup.js",
    "clean": "rm -rf dist lambda.zip lambda-rollup.zip",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.60.0",
    "@aws-sdk/client-cognito-identity-provider": "3.876.0",
    "@aws-sdk/client-dynamodb": "3.876.0",
    "@aws-sdk/lib-dynamodb": "3.876.0",
    "altcha-lib": "1.4.1",
    "aws-jwt-verify": "^4.0.1",
    "moment": "2.30.1",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.140",
    "@types/node": "20.14.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "16.4.5",
    "esbuild": "^0.28.1",
    "ts-node": "10.9.2",
    "typescript": "5.4.5",
    "vitest": "^3.2.4"
  }
}
